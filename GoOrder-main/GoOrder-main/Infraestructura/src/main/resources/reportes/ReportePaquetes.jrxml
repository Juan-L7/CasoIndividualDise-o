<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="ReportePaquetes"
              pageWidth="595"
              pageHeight="842"
              columnWidth="555"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20"
              uuid="12345678-1234-1234-1234-123456789000">

    <parameter name="fechaGeneracion" class="java.lang.String"/>
    <parameter name="rangoFechas" class="java.lang.String"/>
    <parameter name="totalPaquetesRegistrados" class="java.lang.String"/>
    <parameter name="totalPaquetesVendidos" class="java.lang.String"/>
    <parameter name="paqueteMasVendido" class="java.lang.String"/>

    <field name="nombre" class="java.lang.String"/>
    <field name="productos" class="java.lang.String"/>
    <field name="vigencia" class="java.lang.String"/>
    <field name="precio" class="java.lang.String"/>

    <title>
        <band height="285">

            <staticText>
                <reportElement x="0" y="0" width="450" height="35"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Arial" size="22" isBold="true"/>
                </textElement>
                <text><![CDATA[Reporte de paquetes GoOrder]]></text>
            </staticText>

            <staticText>
                <reportElement x="0" y="50" width="60" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Arial" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Fecha:]]></text>
            </staticText>

            <textField>
                <reportElement x="65" y="50" width="200" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Arial" size="11"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{fechaGeneracion}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="75" width="120" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Arial" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Rango del reporte:]]></text>
            </staticText>

            <textField>
                <reportElement x="125" y="75" width="250" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Arial" size="11"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{rangoFechas}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="110" width="100" height="25"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Arial" size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[Resumen:]]></text>
            </staticText>

            <staticText>
                <reportElement mode="Opaque" x="0" y="140" width="185" height="25" forecolor="#FFFFFF" backcolor="#000000"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Arial" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Total de paquetes registrados]]></text>
            </staticText>

            <staticText>
                <reportElement mode="Opaque" x="185" y="140" width="185" height="25" forecolor="#FFFFFF" backcolor="#000000"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Arial" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Total Paquetes vendidos]]></text>
            </staticText>

            <staticText>
                <reportElement mode="Opaque" x="370" y="140" width="185" height="25" forecolor="#FFFFFF" backcolor="#000000"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Arial" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Paquete mas vendido]]></text>
            </staticText>

            <textField>
                <reportElement mode="Opaque" x="0" y="165" width="185" height="50" backcolor="#EAEAEA"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Arial" size="20" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{totalPaquetesRegistrados}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement mode="Opaque" x="185" y="165" width="185" height="50" backcolor="#EAEAEA"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Arial" size="20" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{totalPaquetesVendidos}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement mode="Opaque" x="370" y="165" width="185" height="50" backcolor="#EAEAEA"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Arial" size="18" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{paqueteMasVendido}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="250" width="100" height="25"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Arial" size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[Paquetes:]]></text>
            </staticText>

        </band>
    </title>

    <columnHeader>
        <band height="30">

            <staticText>
                <reportElement x="0" y="0" width="120" height="30" mode="Opaque" backcolor="#D9D9D9"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Arial" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Nombre]]></text>
            </staticText>

            <staticText>
                <reportElement x="120" y="0" width="220" height="30" mode="Opaque" backcolor="#D9D9D9"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Arial" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Productos]]></text>
            </staticText>

            <staticText>
                <reportElement x="340" y="0" width="120" height="30" mode="Opaque" backcolor="#D9D9D9"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Arial" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Vigencia]]></text>
            </staticText>

            <staticText>
                <reportElement x="460" y="0" width="95" height="30" mode="Opaque" backcolor="#D9D9D9"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Arial" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Precio]]></text>
            </staticText>

        </band>
    </columnHeader>

    <detail>
        <band height="50">

            <textField>
                <reportElement x="15" y="0" width="105" height="50"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="Arial" size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{nombre}]]></textFieldExpression>
            </textField>

            <textField isStretchWithOverflow="true">
                <reportElement x="130" y="0" width="210" height="50"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="Arial" size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{productos}]]></textFieldExpression>
            </textField>

            <textField isStretchWithOverflow="true">
                <reportElement x="340" y="0" width="120" height="50"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Arial" size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{vigencia}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="460" y="0" width="95" height="50"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Arial" size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{precio}]]></textFieldExpression>
            </textField>

        </band>
    </detail>

</jasperReport>